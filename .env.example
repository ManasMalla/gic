# Public origin of the deployed site (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://gic.gitam.edu

# Where applicants pay the registration fee (GITAM GEvents)
GEVENTS_REGISTRATION_URL=https://gevents.gitam.edu/registration/ODkyMg==

# Deno backend (backend/). When unset, the form saves to local disk (.data/) for development.
BACKEND_URL=http://localhost:8080
INTERNAL_API_TOKEN=change-me

# --- Sign-in (Google OIDC) ---
# Create an OAuth client (type "Web application") in Google Cloud Console > APIs & Services > Credentials.
# Authorised redirect URIs must include  <origin>/api/auth/callback  for every origin you use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, 32+ chars, signs the session cookie:  openssl rand -base64 48
SESSION_SECRET=
# Comma-separated public origins allowed to start/finish sign-in (guards the OAuth redirect URI).
APP_ALLOWED_ORIGINS=http://localhost:3000
# Local testing only: sign in with any email, no Google. Ignored when running on Cloud Run.
AUTH_DEV_LOGIN=true

# --- GEvents payment link ---
# AES-256 key (32 random bytes, base64) used to encrypt the founder email + track in the GEvents URL (`data=`).
# MUST be identical for the website and the backend. Share with CATs only if they need to decrypt `data`.
#   openssl rand -base64 32
PAYMENT_LINK_KEY=
# Backend only: set to "false" to stop logging full webhook headers + payloads (they contain payer email/phone).
WEBHOOK_DEBUG_LOG=true
