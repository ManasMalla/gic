{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write=/tmp src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-env --allow-read",
    "check": "deno check src/main.ts",
    "db:generate": "deno run -A npm:prisma@7.10.0 generate",
    "db:diff": "deno run -A npm:prisma@7.10.0 migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
  "imports": {
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@7.10.0",
    "@prisma/client": "npm:@prisma/client@7.10.0",
    "@types/pg": "npm:@types/pg@^8.23.1",
    "aws4fetch": "npm:aws4fetch@1.0.20",
    "pg": "npm:pg@8.16.3",
    "prisma": "npm:prisma@7.10.0",
    "zod": "npm:zod@4.6.5",
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": { "lineWidth": 110 },
  "lint": { "rules": { "tags": ["recommended"] } }
}
